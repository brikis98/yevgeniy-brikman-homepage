---
---
[
  {% for post in site.posts %}
    {%- assign content_without_html = post.content | strip_html -%}
    {
      "title": {% include to-json-string.html text=post.title %},
      "tags": [{% for tag in post.tags %}{% include to-json-string.html text=tag %}{% unless forloop.last %},{% endunless %}{% endfor %}],
      "content": {% include to-json-string.html text=content_without_html %},
      "id": {% include to-json-string.html text=post.id %}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]